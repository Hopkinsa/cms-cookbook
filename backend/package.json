{
  "name": "cms-cookbook-backend",
  "version": "2.0.0",
  "description": "Content management system cookbook - Backend",
  "license": "ISC",
  "author": "Andy Hopkins",
  "type": "module",
  "scripts": {
    "start": "nodemon --config nodemon.json",
    "style": "prettier 'src/**/*.{ts, json}' --write",
    "lint": "npx eslint",
    "test": "jest",
    "test:report": "jest --coverage",
    "deploy": "mkdir -p ../deployment/www/ ../deployment/images/ && cp -R ../helper/* ../deployment/ && cp -R images/* ../deployment/images/ && cp -R src/* ../deployment/www/ && find ../deployment/www/ -name '*.spec.ts' -type f -delete"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "multer": "^2.1.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.2",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
